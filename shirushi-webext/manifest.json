{
  "manifest_version": 3,
  "name": "shirushi",
  "version": "0.1.0",
  "description": "ワンクリックで shirushi にブックマークを登録する",
  "permissions": ["activeTab", "storage", "tabs"],
  "host_permissions": [
    "https://shirushi.harakara.site/*",
    "http://localhost:8181/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/shirushi-muted.svg",
      "48": "icons/shirushi-muted.svg",
      "96": "icons/shirushi-muted.svg"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/shirushi.svg",
    "48": "icons/shirushi.svg",
    "96": "icons/shirushi.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "shirushi@harakara.site",
      "strict_min_version": "109.0"
    }
  }
}
