{
  "manifest_version": 3,
  "name": "__MSG_extensionNameDev__",
  "version": "0.1.0",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "permissions": ["activeTab", "storage"],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/shirushi.svg",
      "48": "icons/shirushi.svg",
      "96": "icons/shirushi.svg"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/shirushi.svg",
    "48": "icons/shirushi.svg",
    "96": "icons/shirushi.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "shirushi-dev@harakara.site",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "authenticationInfo",
          "browsingActivity",
          "websiteContent"
        ]
      }
    }
  }
}
